     uint64_t sessionInd = MakeSessionResInd(session->ueId, session->psi);
-    m_pduSessions[sessionInd] = std::unique_ptr<PduSessionResource>(session);
 
+    /* ------------------------------------------------------------------
+     * → la session existe déjà : on garde l’objet existant mais
